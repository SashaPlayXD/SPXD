diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 6fdee49..24502fe 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -9348,6 +9348,60 @@ tu_CmdDrawMultiEXT(VkCommandBuffer commandBuffer,
 }
 TU_GENX(tu_CmdDrawMultiEXT);
 
+/* Splitting an indexed draw is only invisible to the application when the
+ * draw is a plain, non-instanced triangle list without primitive restart,
+ * tessellation, geometry shaders or transform feedback, and when the fragment
+ * shader doesn't read gl_PrimitiveID (it restarts from 0 in every chunk).
+ */
+static bool
+tu_can_split_indexed_draw(struct tu_cmd_buffer *cmd, uint32_t indexCount,
+                          uint32_t instanceCount)
+{
+   if (instanceCount != 1 || indexCount <= cmd->device->split_indexed_chunk)
+      return false;
+
+   const struct vk_dynamic_graphics_state *ds = &cmd->vk.dynamic_graphics_state;
+   if (ds->ia.primitive_topology != VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST ||
+       ds->ia.primitive_restart_enable)
+      return false;
+
+   const struct tu_shader *tcs = cmd->state.shaders[MESA_SHADER_TESS_CTRL];
+   const struct tu_shader *gs = cmd->state.shaders[MESA_SHADER_GEOMETRY];
+   const struct tu_shader *vs = cmd->state.shaders[MESA_SHADER_VERTEX];
+   const struct tu_shader *fs = cmd->state.shaders[MESA_SHADER_FRAGMENT];
+
+   if ((tcs && tcs->variant) || (gs && gs->variant))
+      return false;
+   if (!vs || !vs->variant || vs->variant->stream_output.num_outputs)
+      return false;
+   if (fs && fs->variant && fs->variant->reads_primid)
+      return false;
+
+   return true;
+}
+
+/* Synchronization emitted after a chunk of a split indexed draw.
+ * TU_SPLIT_SYNC selects the packet (wfi = CP_WAIT_FOR_IDLE, the default and
+ * what Rutabaga does; me = CP_WAIT_FOR_ME; none = nothing) and
+ * TU_SPLIT_SYNC_EVERY emits it only after every Nth chunk. The last chunk of
+ * a draw always gets it when TU_SPLIT_SYNC_LAST is set (default on).
+ */
+static void
+tu_split_indexed_sync(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                      uint32_t chunk_idx, bool last)
+{
+   const struct tu_device *dev = cmd->device;
+   if (dev->split_sync_mode == TU_SPLIT_SYNC_NONE)
+      return;
+   if (!(chunk_idx % dev->split_sync_every == 0 ||
+         (last && dev->split_sync_last)))
+      return;
+   if (dev->split_sync_mode == TU_SPLIT_SYNC_ME)
+      tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
+   else
+      tu_cs_emit_pkt7(cs, CP_WAIT_FOR_IDLE, 0);
+}
+
 template <chip CHIP>
 VKAPI_ATTR void VKAPI_CALL
 tu_CmdDrawIndexed(VkCommandBuffer commandBuffer,
@@ -9364,6 +9418,25 @@ tu_CmdDrawIndexed(VkCommandBuffer commandBuffer,
 
    tu6_draw_common<CHIP>(cmd, cs, true, indexCount);
 
+   if (CHIP >= A8XX && unlikely(cmd->device->split_indexed_draws) &&
+       tu_can_split_indexed_draw(cmd, indexCount, instanceCount)) {
+      const uint32_t chunk = cmd->device->split_indexed_chunk;
+      uint32_t chunks = 0;
+      for (uint32_t done = 0; done < indexCount; done += chunk) {
+         const uint32_t count = MIN2(chunk, indexCount - done);
+         tu_cs_emit_pkt7(cs, CP_DRAW_INDX_OFFSET, 7);
+         tu_cs_emit(cs, tu_draw_initiator(cmd, DI_SRC_SEL_DMA));
+         tu_cs_emit(cs, instanceCount);
+         tu_cs_emit(cs, count);
+         tu_cs_emit(cs, firstIndex + done);
+         tu_cs_emit_qw(cs, cmd->state.index_va);
+         tu_cs_emit(cs, cmd->state.max_index_count);
+         tu_split_indexed_sync(cmd, cs, ++chunks, done + count >= indexCount);
+      }
+      trace_end_draw(&cmd->rp_trace, cs);
+      return;
+   }
+
    tu_cs_emit_pkt7(cs, CP_DRAW_INDX_OFFSET, 7);
    tu_cs_emit(cs, tu_draw_initiator(cmd, DI_SRC_SEL_DMA));
    tu_cs_emit(cs, instanceCount);
diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 57f33fb..fefabfe 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -2994,6 +2994,42 @@ tu_CreateDevice(VkPhysicalDevice physicalDevice,
 
    device->instance = physical_device->instance;
    device->physical_device = physical_device;
+
+   {
+      /* A8xx indexed-draw hang workaround. Enabled per-app through driconf
+       * (tu_split_indexed_draws) and overridable through the environment.
+       */
+      const bool app_default =
+         physical_device->instance->drirc.misc.split_indexed_draws;
+      bool split = debug_get_bool_option("TU_DIAGNOSTIC_SPLIT_INDEXED", app_default);
+      split = debug_get_bool_option("TU_SPLIT_INDEXED", split);
+      int64_t chunk = app_default ? 6144 : 1536;
+      chunk = debug_get_num_option("TU_DIAGNOSTIC_INDEXED_CHUNK", chunk);
+      chunk = debug_get_num_option("TU_SPLIT_INDEXED_CHUNK", chunk);
+      chunk = CLAMP(chunk, 3, 49152);
+      chunk -= chunk % 3; /* keep whole triangles */
+      device->split_indexed_draws = split && physical_device->info->chip >= 8;
+      device->split_indexed_chunk = (uint32_t) chunk;
+
+      const char *sync = os_get_option("TU_SPLIT_SYNC");
+      device->split_sync_mode = TU_SPLIT_SYNC_WFI;
+      if (sync && !strcmp(sync, "me"))
+         device->split_sync_mode = TU_SPLIT_SYNC_ME;
+      else if (sync && !strcmp(sync, "none"))
+         device->split_sync_mode = TU_SPLIT_SYNC_NONE;
+      int64_t every = debug_get_num_option("TU_SPLIT_SYNC_EVERY", 1);
+      device->split_sync_every = (uint32_t) CLAMP(every, 1, 64);
+      device->split_sync_last = debug_get_bool_option("TU_SPLIT_SYNC_LAST", true);
+
+      if (device->split_indexed_draws)
+         mesa_logi("Indexed draw split: enabled, chunk=%u, sync=%s every %u%s, application default=%s",
+                   device->split_indexed_chunk,
+                   device->split_sync_mode == TU_SPLIT_SYNC_ME ? "me" :
+                   device->split_sync_mode == TU_SPLIT_SYNC_NONE ? "none" : "wfi",
+                   device->split_sync_every,
+                   device->split_sync_last ? " + last" : "",
+                   app_default ? "true" : "false");
+   }
    device->device_idx = device->physical_device->device_count++;
 
    result = tu_drm_device_init(device);
